# Maintainer: Julián <173747797+Entropio1984@users.noreply.github.com>
#
# Calamares no está empaquetado en Alpine (ni en la rama estable ni en
# edge; verificado en aports el 2026-10-17), así que Lázaro Linux lo
# compila. Versión probada por Alpine:
#   Alpine v3.24 -> Calamares 3.4.3 (Qt6, KF6, kpmcore 26.04)
# La versión se cambia en config.env (CALAMARES_VERSION) y build.sh la
# pasa como variable de entorno. Al cambiarla, deja sha512sums="" abajo:
# build.sh calcula la suma nueva y la muestra en el registro para fijarla.
pkgname=calamares
pkgver=${CALAMARES_VERSION:-3.4.3}
pkgrel=0
pkgdesc="Instalador gráfico de distribuciones (compilado para Lázaro Linux)"
url="https://calamares.codeberg.page/"
arch="x86_64 x86"
license="GPL-3.0-or-later"
depends="
	kpmcore
	python3
	qt6-qtsvg
	qt6-qtdeclarative
	e2fsprogs
	dosfstools
	"
makedepends="
	cmake
	samurai
	extra-cmake-modules
	qt6-qtbase-dev
	qt6-qttools-dev
	qt6-qtsvg-dev
	qt6-qtdeclarative-dev
	kcoreaddons-dev
	kcrash-dev
	kpmcore-dev
	polkit-qt-dev
	yaml-cpp-dev
	python3-dev
	libpwquality-dev
	"
# Las pruebas de Calamares necesitan una sesión gráfica; la prueba real
# del instalador está en pruebas/ (QEMU).
options="!check"
source="https://codeberg.org/Calamares/calamares/releases/download/v$pkgver/calamares-$pkgver.tar.gz"

# Módulos que no aplican a Alpine (systemd, dracut, initcpio de Arch,
# Plymouth, ZFS) o que Lázaro Linux no usa.
_skip="dracut dracutlukscfg initcpio initcpiocfg initramfs initramfscfg
	plymouthcfg services-systemd plasmalnf zfs zfshostid interactiveterminal
	dummycpp dummyprocess dummypython dummypythonqt oemid tracking
	unpackfs unpackfsc rawfs fsresizer luksbootkeyfile luksopenswaphookcfg"

build() {
	# shellcheck disable=SC2086
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DWITH_QT6=ON \
		-DWITH_PYTHON=ON \
		-DWITH_PYBIND11=ON \
		-DBUILD_TESTING=OFF \
		-DBUILD_SCHEMA_TESTING=OFF \
		-DBUILD_CRASH_REPORTING=OFF \
		-DINSTALL_CONFIG=OFF \
		-DSKIP_MODULES="$(echo $_skip)"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
a0c570cea1117cd70e839afad2ea4ac7e3a674a58bfc546a7890eb268b167272c85bdb376e17e7a02b7317571580bad105fcc5903c3353d7b260f470dea3a311  calamares-3.4.3.tar.gz
"
